<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
</IfModule>

# Ensure index.html is treated as the primary directory index file
DirectoryIndex index.html index.php

# Prevent directory indexing / browsing completely across all directories
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prevent automatic trailing slashes on directories so our rewrite rules work properly
  DirectorySlash Off

  # Preserve authorization headers for PHP endpoints
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # -------------------------------------------------------------
  # 1. CANONICAL 301 REDIRECTS: FORCE NON-WWW TO WWW & FORCE HTTPS
  # -------------------------------------------------------------
  # A. Force non-www to www (cybaemtech.com -> www.cybaemtech.com)
  RewriteCond %{HTTP_HOST} ^cybaemtech\.com(:[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://www.cybaemtech.com/$1 [L,R=301]

  # B. Force HTTPS (Handles direct SSL, Cloudflare, AWS, and proxy termination)
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP:X-Forwarded-SSL} =off
  RewriteCond %{HTTP_HOST} ^(www\.)?cybaemtech\.com$ [NC]
  RewriteRule ^(.*)$ https://www.cybaemtech.com/$1 [L,R=301]

  # C. Force 301 redirect for direct requests to index.html -> /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
  RewriteRule ^index\.html$ https://www.cybaemtech.com/ [L,R=301,NC]

  # -------------------------------------------------------------
  # 2. 301 PERMANENT REDIRECTS: LEGACY, ALIAS & DIRECTORY URLS
  # -------------------------------------------------------------
  RewriteRule ^home/?$ / [L,R=301,NC]
  RewriteRule ^solutions/?$ / [L,R=301,NC]
  RewriteRule ^solutions/managed-it/?$ /cloud-security [L,R=301,NC]
  RewriteRule ^solutions/managed-it-cloud-security/?$ /cloud-security [L,R=301,NC]
  RewriteRule ^solutions/cloud-security/?$ /cloud-security [L,R=301,NC]
  RewriteRule ^solutions/growth-revenue/?$ /digital-growth [L,R=301,NC]
  RewriteRule ^growth-revenue/?$ /digital-growth [L,R=301,NC]
  RewriteRule ^solutions/growth-and-revenue/?$ /digital-growth [L,R=301,NC]
  RewriteRule ^growth-and-revenue/?$ /digital-growth [L,R=301,NC]
  RewriteRule ^solutions/digital-marketing/?$ /digital-growth [L,R=301,NC]
  RewriteRule ^solutions/digital-revenue-growth/?$ /digital-growth [L,R=301,NC]
  RewriteRule ^solutions/it-augmentation/?$ /solutions/it-staff-augmentation [L,R=301,NC]
  RewriteRule ^solutions/it-infrastructure/?$ /cloud-security/it-infrastructure-services [L,R=301,NC]
  RewriteRule ^approach/?$ /life-at-cybaemtech [L,R=301,NC]
  RewriteRule ^career/?$ /careers [L,R=301,NC]
  RewriteRule ^carrier/?$ /careers [L,R=301,NC]

  # Specific Blog canonicalization redirects
  RewriteRule ^blog/best-digital-marketing-strategy-for-pune-it-saas-companiescybaem-tech/?$ https://www.cybaemtech.com/blog/best-digital-marketing-strategy-for-pune-it-saas-companies-cybaem-tech [L,R=301,NC]
  RewriteRule ^blog/strengthening-digital-trust-why-cybersecurity-is-every-business-priority/?$ https://www.cybaemtech.com/blog/strengthening-digital-trust-why-cybersecurity-is-every-businesss-priority [L,R=301,NC]

  # 3. Strip trailing slashes (except root) to standardize URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # -------------------------------------------------------------
  # 4. HARD 410 GONE: PERMANENTLY REMOVED PAGES & SPAM URLS
  # -------------------------------------------------------------
  RewriteRule ^resources(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/linkedin-post- - [G,L,NC]
  RewriteRule ^blog/how-pune-clinics-doctors-can-get-more-leads-with-digital-marketing(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/how-saas-startups-in-pune-can-scale-faster-with-seo-google-?ads(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/the-role-of-content-marketing-in-building-a-strong-business-brand-?online(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/business-technology-trends-in-2026-smarter-digital-solutions-?for-growth(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/from-data-to-delight-how-ai-personalization-shapes-the-modern-customer-journey(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/real-estate-co-working-lead-generation-with-meta-and-google-ads-digital-marketing-company-in-pune(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/the-rise-of-ai-driven-personalization-crafting-experiences-that-convert(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/how-to-build-a-brand-from-the-ground-up-with-digital-marketing(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/why-authenticity-beats-algorithms-in-modern-marketing(/.*)?$ - [G,L,NC]
  RewriteRule ^blog/brand-storytelling-that-actually-resonates-in-a-noisy-world(/.*)?$ - [G,L,NC]

  RewriteRule ^ako(/.*)?$ - [G,L,NC]
  RewriteRule ^rsmf8(/.*)?$ - [G,L,NC]
  RewriteRule ^mml(/.*)?$ - [G,L,NC]
  RewriteRule ^wp-content(/.*)?$ - [G,L,NC]
  RewriteRule ^AMC/?$ - [G,L,NC]
  RewriteRule ^Cybaem_Tech_Portfolio\.pdf$ - [G,L,NC]

  # -------------------------------------------------------------
  # 5. REAL FILES & PRERENDERED HTML FILES
  # -------------------------------------------------------------
  # Always serve real files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # PHP endpoints execute normally
  RewriteRule \.php$ - [L]

  # If a directory contains an index.html file, serve that index.html file directly.
  # This completely eliminates 403 Forbidden errors when refreshing prerendered routes!
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Explicit rules for location / Pune landing pages
  RewriteRule ^in/software-company-in-pune/?$ /in/software-company-in-pune/index.html [L]
  RewriteRule ^in/?$ /in/software-company-in-pune [L,R=301]
  RewriteRule ^software-company-in-pune/?$ /in/software-company-in-pune [L,R=301]
  RewriteRule ^pune-office/?$ /in/software-company-in-pune [L,R=301]

  # Explicit rules for Cloud, Platforms & Industries
  RewriteRule ^cloud-services/aws/?$ /cloud-services/aws/index.html [L]
  RewriteRule ^cloud-services/microsoft-azure/?$ /cloud-services/microsoft-azure/index.html [L]
  RewriteRule ^cloud-security/?$ /cloud-security/index.html [L]
  RewriteRule ^cloud-security/([^/]+)/?$ /cloud-security/$1/index.html [L]
  RewriteRule ^software-platforms/?$ /software-platforms/index.html [L]
  RewriteRule ^software-platforms/([^/]+)/?$ /software-platforms/$1/index.html [L]
  RewriteRule ^digital-growth/?$ /digital-growth/index.html [L]
  RewriteRule ^digital-growth/([^/]+)/?$ /digital-growth/$1/index.html [L]
  RewriteRule ^industries/?$ /industries/index.html [L]
  RewriteRule ^industries/([^/]+)/?$ /industries/$1/index.html [L]

  # Explicit rules for Videos directory & Watch Pages
  RewriteRule ^videos/?$ /videos/index.html [L]
  RewriteRule ^videos/([^/]+)/?$ /videos/$1/index.html [L]

  # Explicit rules for core routes
  RewriteRule ^about/?$ /about/index.html [L]
  RewriteRule ^contact/?$ /contact/index.html [L]
  RewriteRule ^careers/?$ /careers/index.html [L]
  RewriteRule ^life-at-cybaemtech/?$ /life-at-cybaemtech/index.html [L]
  RewriteRule ^blog/?$ /blog/index.html [L]
  RewriteRule ^portfolio/?$ /portfolio/index.html [L]
  RewriteRule ^leadership/?$ /leadership/index.html [L]
  RewriteRule ^leadership/dilip-d'souza/?$ /leadership/dilip-dsouza/index.html [L,R=301]
  RewriteRule ^leadership/([^/]+)/?$ /leadership/$1/index.html [L]
  RewriteRule ^solutions/web-systems/?$ /solutions/web-systems/index.html [L]
  RewriteRule ^solutions/it-staff-augmentation/?$ /solutions/it-staff-augmentation/index.html [L]
  RewriteRule ^solutions/enterprise-software/?$ /solutions/enterprise-software/index.html [L]
  RewriteRule ^solutions/it-infrastructure-services/?$ /solutions/it-infrastructure-services/index.html [L]
  RewriteRule ^blog/([^/]+)/?$ /blog/$1/index.html [L]

  # -------------------------------------------------------------
  # 6. UNIVERSAL SPA CATCH-ALL ROUTING FOR REACT ROUTER
  # Serves /index.html on refresh for all client-side routes
  # -------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /index.html [L]

</IfModule>

# Handle 403 and 404 gracefully via the SPA
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html

SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https:;"

  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(woff2|avif|webp|png|jpg|jpeg|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Accept-Ranges "bytes"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType application/x-javascript "access plus 1 hour"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
